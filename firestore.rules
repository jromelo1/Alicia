rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un usuario solo puede leer/escribir su propio documento de sesión.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function isCircleMember(circleId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleId == circleId;
    }

    match /circles/{circleId} {
      // Cualquier cuenta autenticada puede crear un círculo nuevo (Adulto Mayor,
      // al terminar el onboarding) o consultar si un código existe (paso previo
      // a unirse). Solo un miembro ya vinculado puede modificarlo después.
      // `billing` (estado del pago) solo lo escriben las Cloud Functions de Mercado
      // Pago; `trialStartedAt` no se puede mover hacia adelante para alargar la prueba.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && !('billing' in request.resource.data)
        && request.resource.data.get('trialStartedAt', 0) <= request.time.toMillis() + 300000;
      allow update: if isCircleMember(circleId)
        && request.resource.data.get('billing', null) == resource.data.get('billing', null)
        && request.resource.data.get('trialStartedAt', 0) == resource.data.get('trialStartedAt', 0);
      allow list, delete: if false;

      match /members/{memberId} {
        // Unirse con código = crear tu propio doc de miembro antes de que
        // users/{uid}.circleId exista todavía. Gestionar el círculo (agregar a
        // mano, editar, quitar) requiere ya ser miembro.
        allow create: if isCircleMember(circleId) || (request.auth != null && request.auth.uid == memberId);
        allow read, update, delete: if isCircleMember(circleId);
      }

      match /{subcollection}/{docId} {
        // tokens, checkins, panic/active, familiar_notes, memories
        allow read, write: if isCircleMember(circleId);
      }
    }
  }
}
