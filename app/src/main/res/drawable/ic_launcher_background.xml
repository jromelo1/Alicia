<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo con degradado azul diagonal -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#1E88E5"
                android:endColor="#0D47A1"/>
        </aapt:attr>
    </path>

    <!-- Brillo sutil en la esquina superior izquierda -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="80"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"/>
        </aapt:attr>
    </path>

</vector>
